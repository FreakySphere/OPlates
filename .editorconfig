root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.lua]
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json,cff}]
indent_style = space
indent_size = 2

[*.toc]
end_of_line = crlf

[*.xml]
end_of_line = crlf

[Makefile]
indent_style = tab
